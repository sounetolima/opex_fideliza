{
  "manifest_version": 3,
  "name": "Opex Fideliza — CRM para WhatsApp Web",
  "short_name": "Opex Fideliza",
  "version": "2.7.3",
  "description": "CRM leve para WhatsApp Web: lembretes da agenda, pós-atendimento automático, aniversariantes, funil e histórico de cada cliente.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://opex-fideliza-site.netlify.app/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/page-config.js",
        "vendor/wppconnect-wa.js",
        "src/bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/util.js",
        "src/license.js",
        "src/store.js",
        "src/profiles.js",
        "src/engine.js",
        "src/calendar.js",
        "src/backup.js",
        "src/ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui.css",
        "icons/*"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Opex Fideliza",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "584934876126-er89gu4psdup90in5bjhd82542b05v31.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}